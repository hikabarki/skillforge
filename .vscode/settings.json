{
  "python.analysis.extraPaths": ["src"],
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests"],
  "python.testing.unittestEnabled": false,
  "terminal.integrated.env.windows": { "PYTHONPATH": "src", "PYTHONIOENCODING": "utf-8" },
  "terminal.integrated.env.linux": { "PYTHONPATH": "src", "PYTHONIOENCODING": "utf-8" },
  "files.exclude": { "**/__pycache__": true, "**/*.egg-info": true },
  "[python]": { "editor.rulers": [100] }
}
